{
  "version": "0.4",
  "title": "Westhill Main Footer",
  "type": "footer",
  "content": [
    {
      "id": "wh-footer-main",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "width": { "unit": "px", "size": 1200 },
        "flex_direction": "column",
        "background_background": "classic",
        "background_color": "#0A2645",
        "padding": {
          "unit": "px",
          "top": "80",
          "right": "30",
          "bottom": "40",
          "left": "30",
          "isLinked": false
        }
      },
      "elements": [
        {
          "id": "wh-footer-grid",
          "elType": "container",
          "isInner": true,
          "settings": {
            "flex_direction": "row",
            "flex_wrap": "wrap",
            "justify_content": "space-between",
            "align_items": "flex-start"
          },
          "elements": [
            {
              "id": "wh-footer-col-1",
              "elType": "container",
              "settings": {
                "width": { "unit": "%", "size": 25 },
                "flex_direction": "column"
              },
              "elements": [
                {
                  "id": "wh-footer-logo",
                  "elType": "widget",
                  "widgetType": "image",
                  "settings": {
                    "image": {
                      "url": "https://images.unsplash.com/photo-1594897030264-ab7d87efc473?auto=format&fit=crop&q=80&w=200",
                      "id": ""
                    },
                    "margin": { "unit": "px", "bottom": "20" }
                  }
                },
                {
                  "id": "wh-footer-desc",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p style='color: #A0AEC0;'>Serving and empowering our local community since 1995 through educational programs, youth activities, and family resources.</p>"
                  }
                }
              ]
            },
            {
              "id": "wh-footer-col-2",
              "elType": "container",
              "settings": {
                "width": { "unit": "%", "size": 20 },
                "flex_direction": "column"
              },
              "elements": [
                {
                  "id": "wh-footer-h-links",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Quick Links",
                    "header_size": "h4",
                    "title_color": "#FFFFFF",
                    "typography_typography": "custom",
                    "typography_font_family": "Poppins",
                    "typography_font_size": { "unit": "px", "size": 18 },
                    "margin": { "unit": "px", "bottom": "15" }
                  }
                },
                {
                  "id": "wh-footer-links",
                  "elType": "widget",
                  "widgetType": "nav-menu",
                  "settings": {
                    "menu": "footer-menu",
                    "layout": "vertical",
                    "pointer": "none",
                    "color_menu_item": "#A0AEC0",
                    "color_menu_item_hover": "#F4A222",
                    "typography_typography": "custom",
                    "typography_font_family": "Inter",
                    "typography_font_size": { "unit": "px", "size": 15 }
                  }
                }
              ]
            },
            {
              "id": "wh-footer-col-3",
              "elType": "container",
              "settings": {
                "width": { "unit": "%", "size": 25 },
                "flex_direction": "column"
              },
              "elements": [
                {
                  "id": "wh-footer-h-contact",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Contact Info",
                    "header_size": "h4",
                    "title_color": "#FFFFFF",
                    "typography_typography": "custom",
                    "typography_font_family": "Poppins",
                    "typography_font_size": { "unit": "px", "size": 18 },
                    "margin": { "unit": "px", "bottom": "15" }
                  }
                },
                {
                  "id": "wh-footer-contact-details",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<ul style='list-style: none; padding: 0; margin: 0; color: #A0AEC0; line-height: 2;'><li style='margin-bottom: 8px;'><span style='color: #F4A222; margin-right: 8px;'>📍</span>123 West Hill Road, Scarborough, ON</li><li style='margin-bottom: 8px;'><span style='color: #F4A222; margin-right: 8px;'>📞</span>(416) 555-0199</li><li style='margin-bottom: 8px;'><span style='color: #F4A222; margin-right: 8px;'>✉️</span>info@westhillcommunity.org</li></ul>"
                  }
                }
              ]
            },
            {
              "id": "wh-footer-col-4",
              "elType": "container",
              "settings": {
                "width": { "unit": "%", "size": 25 },
                "flex_direction": "column"
              },
              "elements": [
                {
                  "id": "wh-footer-h-news",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Stay Connected",
                    "header_size": "h4",
                    "title_color": "#FFFFFF",
                    "typography_typography": "custom",
                    "typography_font_family": "Poppins",
                    "typography_font_size": { "unit": "px", "size": 18 },
                    "margin": { "unit": "px", "bottom": "15" }
                  }
                },
                {
                  "id": "wh-footer-newsletter-desc",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p style='color: #A0AEC0; margin-bottom: 15px;'>Sign up for our newsletter to get monthly updates on events.</p>"
                  }
                },
                {
                  "id": "wh-footer-form",
                  "elType": "widget",
                  "widgetType": "form",
                  "settings": {
                    "form_name": "Footer Newsletter",
                    "submit_button_text": "Subscribe",
                    "submit_button_background_color": "#F4A222",
                    "submit_button_text_color": "#FFFFFF",
                    "submit_button_border_radius": {
                      "unit": "px",
                      "top": "8",
                      "right": "8",
                      "bottom": "8",
                      "left": "8",
                      "isLinked": true
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "wh-footer-divider",
          "elType": "widget",
          "widgetType": "divider",
          "settings": {
            "color": "#1A5492",
            "weight": { "size": 1 },
            "gap": { "size": 40 }
          }
        },
        {
          "id": "wh-footer-bottom",
          "elType": "container",
          "isInner": true,
          "settings": {
            "flex_direction": "row",
            "flex_wrap": "nowrap",
            "justify_content": "space-between",
            "align_items": "center"
          },
          "elements": [
            {
              "id": "wh-footer-copyright",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p style='color: #718096; margin: 0;'>&copy; 2026 West Hill Community Center. All rights reserved.</p>"
              }
            },
            {
              "id": "wh-footer-socials",
              "elType": "widget",
              "widgetType": "social-icons",
              "settings": {
                "social_icon_list": [
                  { "social": "facebook", "link": { "url": "https://facebook.com/westhill" } },
                  { "social": "instagram", "link": { "url": "https://instagram.com/westhill" } },
                  { "social": "twitter", "link": { "url": "https://twitter.com/westhill" } }
                ],
                "shape": "circle",
                "align": "right",
                "color_type": "custom",
                "icon_color": "#A0AEC0",
                "icon_color_hover": "#F4A222",
                "icon_background_color": "rgba(255,255,255,0.05)",
                "icon_background_color_hover": "rgba(255,255,255,0.1)"
              }
            }
          ]
        }
      ]
    }
  ]
}
