{
  "version": "0.4",
  "title": "Single Program Template",
  "type": "single",
  "content": [
    {
      "id": "wh-program-hero",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "full",
        "min_height": { "unit": "px", "size": 220 },
        "flex_direction": "column",
        "justify_content": "center",
        "align_items": "center",
        "background_background": "classic",
        "background_color": "#0F3B6A",
        "padding": { "unit": "px", "top": "50", "right": "20", "bottom": "50", "left": "20", "isLinked": true }
      },
      "elements": [
        {
          "id": "wh-program-dynamic-title",
          "elType": "widget",
          "widgetType": "post-title",
          "settings": {
            "align": "center",
            "color": "#FFFFFF",
            "typography_typography": "custom",
            "typography_font_family": "Poppins",
            "typography_font_size": { "unit": "px", "size": 38 },
            "typography_font_weight": "700"
          }
        }
      ]
    },
    {
      "id": "wh-program-body-layout",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "width": { "unit": "px", "size": 1200 },
        "flex_direction": "row",
        "flex_wrap": "wrap",
        "justify_content": "space-between",
        "padding": { "unit": "px", "top": "60", "right": "30", "bottom": "60", "left": "30", "isLinked": false }
      },
      "elements": [
        {
          "id": "wh-program-main-col",
          "elType": "container",
          "settings": {
            "width": { "unit": "%", "size": 68 },
            "flex_direction": "column"
          },
          "elements": [
            {
              "id": "wh-program-feat-img",
              "elType": "widget",
              "widgetType": "theme-post-featured-image",
              "settings": {
                "image_size": "large",
                "align": "center",
                "margin": { "unit": "px", "bottom": "30" }
              }
            },
            {
              "id": "wh-program-content",
              "elType": "widget",
              "widgetType": "post-content",
              "settings": {}
            }
          ]
        },
        {
          "id": "wh-program-sidebar",
          "elType": "container",
          "settings": {
            "width": { "unit": "%", "size": 28 },
            "background_background": "classic",
            "background_color": "#F8F9FA",
            "padding": { "unit": "px", "top": "30", "right": "20", "bottom": "30", "left": "20", "isLinked": true },
            "border_radius": { "unit": "px", "top": "12", "right": "12", "bottom": "12", "left": "12", "isLinked": true },
            "border_border": "solid",
            "border_width": { "unit": "px", "top": "4", "right": "0", "bottom": "0", "left": "0", "isLinked": false },
            "border_color": "#0F3B6A",
            "box_shadow_box_shadow_type": "yes",
            "box_shadow_box_shadow": { "horizontal": 0, "vertical": 8, "blur": 20, "spread": 0, "color": "rgba(15, 59, 106, 0.04)" }
          },
          "elements": [
            {
              "id": "wh-sidebar-title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Program Details",
                "header_size": "h4",
                "title_color": "#0F3B6A",
                "typography_typography": "custom",
                "typography_font_family": "Poppins",
                "typography_font_size": { "unit": "px", "size": 18 },
                "margin": { "unit": "px", "bottom": "20" }
              }
            },
            {
              "id": "wh-sidebar-info",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<ul style='list-style: none; padding: 0; margin: 0 0 25px; line-height: 2.2; color: #4A5568;'><li style='margin-bottom: 8px;'><strong style='color: #0F3B6A;'>📅 Schedule:</strong> Weekly sessions</li><li style='margin-bottom: 8px;'><strong style='color: #0F3B6A;'>👥 Age Group:</strong> All welcome</li><li style='margin-bottom: 8px;'><strong style='color: #0F3B6A;'>📍 Location:</strong> Room 104</li><li style='margin-bottom: 8px;'><strong style='color: #0F3B6A;'>💵 Cost:</strong> Free / Sponsored</li></ul>"
              }
            },
            {
              "id": "wh-sidebar-cta",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "Register Interest",
                "link": { "url": "/contact/" },
                "align": "justify",
                "background_color": "#F4A222",
                "color_text": "#FFFFFF",
                "typography_typography": "custom",
                "typography_font_family": "Poppins",
                "typography_font_weight": "600",
                "border_radius": { "unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true }
              }
            }
          ]
        }
      ]
    }
  ]
}
