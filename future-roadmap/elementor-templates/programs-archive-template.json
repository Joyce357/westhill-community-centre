{
  "version": "0.4",
  "title": "Programs Archive Template",
  "type": "archive",
  "content": [
    {
      "id": "wh-archive-hero",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "full",
        "min_height": { "unit": "px", "size": 220 },
        "flex_direction": "column",
        "justify_content": "center",
        "align_items": "center",
        "background_background": "classic",
        "background_color": "#0F3B6A",
        "padding": { "unit": "px", "top": "50", "right": "20", "bottom": "50", "left": "20", "isLinked": true }
      },
      "elements": [
        {
          "id": "wh-archive-dynamic-title",
          "elType": "widget",
          "widgetType": "archive-title",
          "settings": {
            "align": "center",
            "color": "#FFFFFF",
            "typography_typography": "custom",
            "typography_font_family": "Poppins",
            "typography_font_size": { "unit": "px", "size": 38 },
            "typography_font_weight": "700"
          }
        }
      ]
    },
    {
      "id": "wh-archive-body-layout",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "width": { "unit": "px", "size": 1200 },
        "flex_direction": "column",
        "padding": { "unit": "px", "top": "80", "right": "30", "bottom": "80", "left": "30", "isLinked": false }
      },
      "elements": [
        {
          "id": "wh-archive-posts-widget",
          "elType": "widget",
          "widgetType": "archive-posts",
          "settings": {
            "columns": "3",
            "columns_tablet": "2",
            "columns_mobile": "1",
            "posts_per_page": "9",
            "show_image": "yes",
            "image_size": "medium_large",
            "show_title": "yes",
            "show_excerpt": "yes",
            "excerpt_length": 25,
            "show_read_more": "yes",
            "read_more_text": "Read More",
            "show_meta": "none",
            "classic_color_title": "#0F3B6A",
            "classic_color_excerpt": "#4A5568",
            "classic_color_read_more": "#2B8E56",
            "classic_card_border_radius": { "unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true },
            "classic_card_box_shadow_box_shadow_type": "yes",
            "classic_card_box_shadow_box_shadow": { "horizontal": 0, "vertical": 10, "blur": 25, "spread": 0, "color": "rgba(15, 59, 106, 0.04)" }
          }
        }
      ]
    }
  ]
}
