{
  "version": "0.4",
  "title": "Westhill Contact Page",
  "type": "page",
  "content": [
    {
      "id": "wh-contact-hero",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "full",
        "min_height": { "unit": "px", "size": 250 },
        "flex_direction": "column",
        "justify_content": "center",
        "align_items": "center",
        "background_background": "classic",
        "background_color": "#0F3B6A",
        "padding": { "unit": "px", "top": "60", "right": "20", "bottom": "60", "left": "20", "isLinked": true }
      },
      "elements": [
        {
          "id": "wh-contact-h1",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Get In Touch",
            "header_size": "h1",
            "align": "center",
            "title_color": "#FFFFFF",
            "typography_typography": "custom",
            "typography_font_family": "Poppins",
            "typography_font_size": { "unit": "px", "size": 42 },
            "typography_font_weight": "700",
            "margin": { "unit": "px", "bottom": "10" }
          }
        },
        {
          "id": "wh-contact-sub",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style='text-align: center; color: #E2E8F0; font-size: 16px; margin: 0;'>Have a question about our programs? Want to volunteer? Reach out to us below.</p>"
          }
        }
      ]
    },
    {
      "id": "wh-contact-main",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "width": { "unit": "px", "size": 1200 },
        "flex_direction": "row",
        "flex_wrap": "wrap",
        "justify_content": "space-between",
        "padding": { "unit": "px", "top": "80", "right": "30", "bottom": "80", "left": "30", "isLinked": false }
      },
      "elements": [
        {
          "id": "wh-contact-left",
          "elType": "container",
          "settings": {
            "width": { "unit": "%", "size": 40 },
            "flex_direction": "column",
            "gap": { "unit": "px", "size": 20 }
          },
          "elements": [
            {
              "id": "wh-contact-card-1",
              "elType": "container",
              "settings": {
                "background_background": "classic",
                "background_color": "#FFFFFF",
                "padding": { "unit": "px", "top": "25", "right": "20", "bottom": "25", "left": "20", "isLinked": true },
                "border_radius": { "unit": "px", "top": "12", "right": "12", "bottom": "12", "left": "12", "isLinked": true },
                "box_shadow_box_shadow_type": "yes",
                "box_shadow_box_shadow": { "horizontal": 0, "vertical": 8, "blur": 20, "spread": 0, "color": "rgba(15, 59, 106, 0.04)" }
              },
              "elements": [
                {
                  "id": "wh-contact-icon-1",
                  "elType": "widget",
                  "widgetType": "icon",
                  "settings": {
                    "icon": { "value": "fas fa-map-marker-alt", "library": "fa-solid" },
                    "primary_color": "#2B8E56",
                    "size": { "unit": "px", "size": 24 },
                    "margin": { "unit": "px", "bottom": "10" }
                  }
                },
                {
                  "id": "wh-contact-h-1",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Our Location",
                    "header_size": "h4",
                    "title_color": "#0F3B6A",
                    "typography_typography": "custom",
                    "typography_font_family": "Poppins",
                    "typography_font_size": { "unit": "px", "size": 16 },
                    "margin": { "unit": "px", "bottom": "5" }
                  }
                },
                {
                  "id": "wh-contact-text-1",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p style='color: #718096; margin: 0;'>123 West Hill Road, Scarborough, ON M1E 3V5</p>"
                  }
                }
              ]
            },
            {
              "id": "wh-contact-card-2",
              "elType": "container",
              "settings": {
                "background_background": "classic",
                "background_color": "#FFFFFF",
                "padding": { "unit": "px", "top": "25", "right": "20", "bottom": "25", "left": "20", "isLinked": true },
                "border_radius": { "unit": "px", "top": "12", "right": "12", "bottom": "12", "left": "12", "isLinked": true },
                "box_shadow_box_shadow_type": "yes",
                "box_shadow_box_shadow": { "horizontal": 0, "vertical": 8, "blur": 20, "spread": 0, "color": "rgba(15, 59, 106, 0.04)" }
              },
              "elements": [
                {
                  "id": "wh-contact-icon-2",
                  "elType": "widget",
                  "widgetType": "icon",
                  "settings": {
                    "icon": { "value": "fas fa-phone", "library": "fa-solid" },
                    "primary_color": "#2B8E56",
                    "size": { "unit": "px", "size": 24 },
                    "margin": { "unit": "px", "bottom": "10" }
                  }
                },
                {
                  "id": "wh-contact-h-2",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Phone & Email",
                    "header_size": "h4",
                    "title_color": "#0F3B6A",
                    "typography_typography": "custom",
                    "typography_font_family": "Poppins",
                    "typography_font_size": { "unit": "px", "size": 16 },
                    "margin": { "unit": "px", "bottom": "5" }
                  }
                },
                {
                  "id": "wh-contact-text-2",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p style='color: #718096; margin: 0;'>📞 (416) 555-0199<br>✉️ info@westhillcommunity.org</p>"
                  }
                }
              ]
            },
            {
              "id": "wh-contact-card-3",
              "elType": "container",
              "settings": {
                "background_background": "classic",
                "background_color": "#FFFFFF",
                "padding": { "unit": "px", "top": "25", "right": "20", "bottom": "25", "left": "20", "isLinked": true },
                "border_radius": { "unit": "px", "top": "12", "right": "12", "bottom": "12", "left": "12", "isLinked": true },
                "box_shadow_box_shadow_type": "yes",
                "box_shadow_box_shadow": { "horizontal": 0, "vertical": 8, "blur": 20, "spread": 0, "color": "rgba(15, 59, 106, 0.04)" }
              },
              "elements": [
                {
                  "id": "wh-contact-icon-3",
                  "elType": "widget",
                  "widgetType": "icon",
                  "settings": {
                    "icon": { "value": "fas fa-clock", "library": "fa-solid" },
                    "primary_color": "#2B8E56",
                    "size": { "unit": "px", "size": 24 },
                    "margin": { "unit": "px", "bottom": "10" }
                  }
                },
                {
                  "id": "wh-contact-h-3",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Hours of Operation",
                    "header_size": "h4",
                    "title_color": "#0F3B6A",
                    "typography_typography": "custom",
                    "typography_font_family": "Poppins",
                    "typography_font_size": { "unit": "px", "size": 16 },
                    "margin": { "unit": "px", "bottom": "5" }
                  }
                },
                {
                  "id": "wh-contact-text-3",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p style='color: #718096; margin: 0;'>Monday - Friday: 8:30 AM - 8:00 PM<br>Saturday: 9:00 AM - 4:00 PM<br>Sunday: Closed</p>"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "wh-contact-right",
          "elType": "container",
          "settings": {
            "width": { "unit": "%", "size": 55 },
            "background_background": "classic",
            "background_color": "#FFFFFF",
            "padding": { "unit": "px", "top": "40", "right": "40", "bottom": "40", "left": "40", "isLinked": true },
            "border_radius": { "unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true },
            "box_shadow_box_shadow_type": "yes",
            "box_shadow_box_shadow": { "horizontal": 0, "vertical": 12, "blur": 30, "spread": 0, "color": "rgba(15, 59, 106, 0.06)" }
          },
          "elements": [
            {
              "id": "wh-contact-form-h",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Send Us a Message",
                "header_size": "h2",
                "title_color": "#0F3B6A",
                "typography_typography": "custom",
                "typography_font_family": "Poppins",
                "typography_font_weight": "600",
                "margin": { "unit": "px", "bottom": "25" }
              }
            },
            {
              "id": "wh-contact-form",
              "elType": "widget",
              "widgetType": "form",
              "settings": {
                "form_name": "Westhill Contact Form",
                "submit_button_text": "Send Message",
                "submit_button_background_color": "#0F3B6A",
                "submit_button_text_color": "#FFFFFF",
                "submit_button_border_radius": { "unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true },
                "submit_button_padding": { "unit": "px", "top": "14", "right": "28", "bottom": "14", "left": "28", "isLinked": false }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "wh-contact-map-section",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "full",
        "padding": { "unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true }
      },
      "elements": [
        {
          "id": "wh-contact-map-widget",
          "elType": "widget",
          "widgetType": "google_maps",
          "settings": {
            "address": "123 West Hill Rd, Scarborough, ON",
            "zoom": { "size": 15 },
            "height": { "size": 450 }
          }
        }
      ]
    }
  ]
}
