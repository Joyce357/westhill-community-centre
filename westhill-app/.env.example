# PostgreSQL Database URL (Neon, Supabase, Railway, or local PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/westhill_db?schema=public"

# Auth Session Secret (Generate a strong random string)
SESSION_SECRET="your-32-character-or-longer-random-secret-key"

# Bootstrap Initial Administrator (Hashed securely upon seeding, never logged)
INITIAL_ADMIN_EMAIL="admin@westhillcommunitycentre.ca"
INITIAL_ADMIN_PASSWORD="replace_with_secure_admin_password"

# Public Site URL
NEXT_PUBLIC_SITE_URL="https://westhillcommunitycentre.ca"
